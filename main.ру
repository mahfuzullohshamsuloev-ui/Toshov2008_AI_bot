# -*- coding: utf-8 -*-
import os
import threading
import telebot
from openai import OpenAI
from flask import Flask

# --- Сервери хурд барои Render ---
# То Render фаҳмад, ки бот зинда аст
app = Flask(__name__)

@app.route('/')
def home():
    return "ToshovGPT is alive! 👋"

def run_web():
    port = int(os.environ.get("PORT", 10000))
    app.run(host="0.0.0.0", port=port)

# --- БОТ ---
TELEGRAM_TOKEN = os.getenv("TELEGRAM_TOKEN")
OPENAI_API_KEY = os.getenv("OPENAI_API_KEY")

bot = telebot.TeleBot(TELEGRAM_TOKEN)
client = OpenAI(api_key=OPENAI_API_KEY)

SYSTEM_PROMPT = "Tu ToshovGPT hasti. Tu dusti mehribon va shogirdi odob hasti. Bo zaboni tojiki gap mezani. Khudro hamesha ToshovGPT muarrifi kun. Hamesha khushmuomila, sodda va garm gap bizan. Hich vakht khudro robot naguy, guy ki ToshovGPT hastam, dusti tu."

user_histories = {}
MAX_HISTORY = 20

def get_history(user_id):
    if user_id not in user_histories:
        user_histories[user_id] = []
    return user_histories[user_id]

@bot.message_handler(commands=['start', 'help'])
def send_welcome(message):
    user_histories[message.chat.id] = []
    bot.reply_to(message, "Салом! 👋 Хуш омадед! Имрӯз ба шумо бо чӣ ёрӣ расонам?")

@bot.message_handler(commands=['new'])
def new_chat(message):
    user_histories[message.chat.id] = []
    bot.reply_to(message, "Хуб! Сӯҳбати навро сар кардем. 👋 Чӣ ёрӣ расонам?")

@bot.message_handler(func=lambda message: True, content_types=['text'])
def answer(message):
    try:
        if not message.text:
            return
        user_id = message.chat.id
        history = get_history(user_id)
        history.append({"role": "user", "content": message.text})
        if len(history) > MAX_HISTORY:
            history = history[-MAX_HISTORY:]
            user_histories[user_id] = history
        response = client.chat.completions.create(
            model="gpt-6.2-astra",
            messages=[{"role": "system", "content": SYSTEM_PROMPT}] + history
        )
        text = response.choices[0].message.content
        history.append({"role": "assistant", "content": text})
        for i in range(0, len(text), 4000):
            part = text[i:i+4000]
            if i == 0:
                bot.reply_to(message, part)
            else:
                bot.send_message(message.chat.id, part)
    except Exception as e:
        print(f"Хатогӣ: {e}")
        bot.reply_to(message, "Бубахшед, каме хатогӣ шуд. Лутфан боз як бор нависед!")

if __name__ == "__main__":
    # Веб-серверро дар паси парда ба кор меандозем
    threading.Thread(target=run_web, daemon=True).start()
    print("ToshovGPT 24/7 кор мекунад...")
    bot.polling(none_stop=True, skip_pending=True)
